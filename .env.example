# Elastic settings are NOT kept in this file. Export them in your shell before `npm start`
# (the EDOT SDK reads them at startup, before the app loads .env):
#
#   export OTEL_EXPORTER_OTLP_ENDPOINT="https://<your-project>.ingest.<region>.elastic.cloud:443"
#   export OTEL_EXPORTER_OTLP_HEADERS="Authorization=ApiKey <your-api-key>"
#   export OTEL_SERVICE_NAME="skyward-travel-app"

DATABASE_URL=postgres://postgres:postgres@localhost:5432/skyward

# --- Chaos flags (default: all on). Set one to false to fix that problem. ---
# CHAOS_STAIRCASE=true
# CHAOS_GAP=true
# CHAOS_PARTNER=true

# --- Partners ---
PARTNER_HOST=localhost
PARTNER_LATENCY_MS=1300
# Opt-in scenario for the CHAOS_PARTNER / booking bug: Penguin Air adds 5.2 s and 15% 503s
PENGUIN_DEGRADED=false

# --- Debugging purpose only ---
FARES_PER_PARTNER=3000
PARTNER_FAIL_RATE=0.03
SHOW_LOADING_TIMER=true
