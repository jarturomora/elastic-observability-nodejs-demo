# Copy to .env (git-ignored). `npm start` runs `node --env-file=.env --import @elastic/opentelemetry-node ...`
# and Node reads --env-file BEFORE the EDOT preload runs, so OTEL_* below reach the SDK in time.
# A variable already exported in your shell wins over this file.

# ── Elastic (EDOT) ───────────────────────────────────────────────────────────
# Without an endpoint the SDK has nowhere to send data (the app still runs).
OTEL_SERVICE_NAME=skyward-travel-app
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-project>.ingest.<region>.elastic.cloud:443
# Keep the quotes: the value contains a space (this also lets you load the file with `set -a; source .env; set +a`)
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=ApiKey <your-api-key>"
# EDOT sends the app's pino logs to Elastic only when this is true (off by default). Logs are
# correlated with traces by trace ID either way.
ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING=true
# Opt-in: record prompt/response text on the model span. Demo data is synthetic, but it still
# includes the user's search history and the question, so leave off unless you want to show it.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# ── Chat model ───────────────────────────────────────────────────────────────
# Default (nothing to set): a small local model, qwen2.5:1.5b, served by the Ollama container that
# `npm run services` starts at http://localhost:11434. To use OpenAI instead, uncomment:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Local model to download and use (~400 MB option: qwen2.5:0.5b)
# LOCAL_MODEL=qwen2.5:1.5b

# ── The two intentional bugs (both on = the recording scenario) ─────────────
# search calls the four partners one after another
CHAOS_STAIRCASE=true
# /api/chat forgets to await the history query
CHAOS_CHAT=true
# ENABLE_CHAOS=false forces both off (the "fixed" build)

# ── Partner mocks ────────────────────────────────────────────────────────────
# Every partner takes this long to answer; it is what makes the staircase visible.
# Re-run `npm run services` after changing it.
PARTNER_LATENCY_MS=1300
